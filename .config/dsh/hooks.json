{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^bash$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/flow/verify_hook.py pretool",
            "timeout": 900
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/flow/verify_hook.py stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
