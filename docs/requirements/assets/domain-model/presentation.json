{
  "domains": {
    "string": {
      "kind": "primitive"
    },
    "boolean": {
      "kind": "primitive"
    },
    "number": {
      "kind": "primitive"
    },
    "datetime": {
      "kind": "primitive"
    },
    "status": {
      "kind": "state",
      "logical": "string",
      "values": [
        "do",
        "done",
        "skip"
      ]
    }
  },
  "entities": {
    "tasks": {
      "description": "タスク。実行対象・完了・見送りを status で表す。",
      "attributes": {
        "id": {
          "domain": "string",
          "pk": true
        },
        "owner_id": {
          "domain": "string"
        },
        "title": {
          "domain": "string",
          "note": "Unicodeコードポイント数で1以上256以下",
          "rules": [
            "INV-TM-005"
          ]
        },
        "description": {
          "domain": "string",
          "note": "Unicodeコードポイント数で0以上16,384以下",
          "rules": [
            "INV-TM-006"
          ]
        },
        "status": {
          "domain": "status",
          "rules": [
            "INV-TM-001"
          ]
        },
        "working": {
          "domain": "boolean",
          "rules": [
            "INV-TM-003"
          ]
        },
        "project": {
          "domain": "string",
          "note": "projects.id または未設定（NULL）",
          "rules": [
            "INV-TM-002"
          ]
        },
        "order": {
          "domain": "number",
          "note": "owner_id 内の表示順"
        },
        "version": {
          "domain": "number"
        },
        "created_at": {
          "domain": "datetime"
        },
        "updated_at": {
          "domain": "datetime"
        }
      },
      "rules": [
        "INV-TM-004"
      ]
    },
    "projects": {
      "description": "タスクの分類先。sort_order の昇順で表示する。",
      "attributes": {
        "id": {
          "domain": "string",
          "pk": true
        },
        "name": {
          "domain": "string"
        },
        "sort_order": {
          "domain": "number"
        }
      }
    },
    "ideas": {
      "description": "タスクとは独立したアイデア。カード一覧で表示する。",
      "attributes": {
        "id": {
          "domain": "string",
          "pk": true
        },
        "owner_id": {
          "domain": "string"
        },
        "title": {
          "domain": "string",
          "note": "Title 値オブジェクト。Unicodeコードポイント数で1以上256以下",
          "rules": [
            "INV-TM-005"
          ]
        },
        "description": {
          "domain": "string",
          "note": "Description 値オブジェクト。Unicodeコードポイント数で0以上16,384以下",
          "rules": [
            "INV-TM-006"
          ]
        },
        "order": {
          "domain": "number"
        },
        "pinned": {
          "domain": "boolean",
          "note": "固定表示するかどうか"
        }
      }
    }
  },
  "relations": [],
  "flows": {
    "task_management": {
      "name": "タスクを管理する",
      "actor": "user",
      "steps": [
        {
          "name": "タスクを登録する",
          "entity": "tasks",
          "changes": {
            "status": "do"
          }
        },
        {
          "name": "プロジェクトを決める",
          "entity": "tasks",
          "changes": {
            "project": "プロジェクトIDまたは未設定"
          }
        },
        {
          "name": "実行中にする",
          "entity": "tasks",
          "changes": {
            "working": true
          }
        },
        {
          "name": "完了または見送りにする",
          "entity": "tasks",
          "changes": {
            "status": [
              "done",
              "skip"
            ]
          }
        },
        {
          "name": "一覧で振り返る",
          "entity": "tasks"
        },
        {
          "name": "Idea から Task へ移動する",
          "entity": "tasks",
          "changes": {
            "status": "do",
            "working": false
          }
        }
      ]
    },
    "idea_management": {
      "name": "アイデアを管理する",
      "actor": "user",
      "steps": [
        {
          "name": "Ideaを表示する",
          "entity": "ideas",
          "when": "pinned を先にして各グループ内を order の昇順でカード表示"
        },
        {
          "name": "Ideaを作成する",
          "entity": "ideas",
          "changes": {
            "title": "入力値",
            "description": "入力値",
            "order": "末尾",
            "pinned": false
          }
        },
        {
          "name": "Ideaを編集する",
          "entity": "ideas",
          "changes": {
            "title": "入力値",
            "description": "入力値"
          }
        },
        {
          "name": "Ideaのピン留め状態を切り替える",
          "entity": "ideas",
          "changes": {
            "pinned": [
              true,
              false
            ]
          }
        },
        {
          "name": "Ideaを並べ替える",
          "entity": "ideas",
          "changes": {
            "order": "新しい表示順"
          }
        },
        {
          "name": "Ideaを削除する",
          "entity": "ideas",
          "when": "確認後に一覧から除外"
        },
        {
          "name": "Task から Idea へ移動する",
          "entity": "ideas",
          "changes": {
            "pinned": false,
            "order": "末尾"
          }
        }
      ]
    }
  },
  "screens": {
    "P00": {
      "name": "Login",
      "entities": [
        "tasks"
      ],
      "onLoad": "html_login_page",
      "actions": [
        "github-login"
      ]
    },
    "P02": {
      "name": "Task list",
      "entities": [
        "tasks",
        "projects"
      ],
      "onLoad": "html_tasks_page",
      "references": [
        "tasks_list"
      ],
      "actions": [
        "filter",
        "bulk",
        "project",
        "delete"
      ]
    },
    "P03": {
      "name": "Task detail",
      "entities": [
        "tasks",
        "projects"
      ],
      "onLoad": "html_task_page",
      "references": [
        "tasks_get"
      ],
      "actions": [
        "edit",
        "save",
        "select-project"
      ]
    },
    "P04": {
      "name": "New task",
      "entities": [
        "tasks",
        "projects"
      ],
      "onLoad": "html_new_task_page",
      "references": [
        "tasks_create"
      ],
      "actions": [
        "create",
        "select-project",
        "cancel"
      ]
    },
    "P05": {
      "name": "Status popover",
      "entities": [
        "tasks"
      ],
      "actions": [
        "select-status"
      ]
    },
    "P08": {
      "name": "Idea list",
      "entities": [
        "ideas"
      ],
      "onLoad": "html_ideas_page",
      "references": [
        "ideas_list"
      ],
      "actions": [
        "create",
        "edit",
        "delete",
        "pin",
        "reorder",
        "move-to-task"
      ]
    }
  },
