# ドメインモデル図。正本の補助。正本は domain.md と domain-model.json。
direction: down

task: "Task（エンティティ）" {
  shape: class
  invariant_002: "INV-TM-002: projectはprojects.idまたは未設定"
  invariant_003: "INV-TM-003: workingはstatusと独立"
  invariant_004: "INV-TM-004: orderはowner_id内で連番"
  +title: Title
  +description: Description
  +status: Status
  +project: Project
  +working: boolean
  +order: number
}

title: "Title（値オブジェクト）" {
  shape: class
  invariant_005: "INV-TM-005: title の長さはUnicodeコードポイント数で1以上256以下とする"
  +value: string
  min_length: "1"
  max_length: "256"
}

description: "Description（値オブジェクト）" {
  shape: class
  invariant_006: "INV-TM-006: description の長さはUnicodeコードポイント数で0以上16,384以下とする"
  +value: string
  min_length: "0"
  max_length: "16,384"
}

status: "Status（値オブジェクト）" {
  shape: class
  invariant_001: "INV-TM-001: status は do / done / skip のいずれか"
  +value: do | done | skip
}

project: "Project（エンティティ）" {
  shape: class
  +id: string
  +name: string
  +sort_order: number
}

task -> status: status
task -> project: project
task -> title: title
task -> description: description

idea: "Idea（エンティティ）" {
  shape: class
  +title: Title
  +description: Description
  +order: number
  +pinned: boolean
}

idea -> title: title
idea -> description: description
