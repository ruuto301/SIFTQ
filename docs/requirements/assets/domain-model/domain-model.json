  "flows": {
    "task_management": {
      "name": "タスクを管理する",
      "actor": "user",
      "steps": [
        {
          "name": "タスクを登録する",
          "entity": "tasks",
          "changes": {
            "status": "do"
          }
        },
        {
          "name": "プロジェクトを決める",
          "entity": "tasks",
          "changes": {
            "project": "プロジェクトIDまたは未設定"
          }
        },
        {
          "name": "実行中にする",
          "entity": "tasks",
          "changes": {
            "working": true
          }
        },
        {
          "name": "完了または見送りにする",
          "entity": "tasks",
          "changes": {
            "status": [
              "done",
              "skip"
            ]
          }
        },
        {
          "name": "一覧で振り返る",
          "entity": "tasks"
        },
        {
          "name": "Idea から Task へ移動する",
          "entity": "tasks",
          "changes": {
            "status": "do",
            "working": false
          }
        }
      ]
    },
    "idea_management": {
      "name": "アイデアを管理する",
      "actor": "user",
      "steps": [
        {
          "name": "Ideaを表示する",
          "entity": "ideas",
          "when": "pinned を先にして各グループ内を order の昇順でカード表示"
        },
        {
          "name": "Ideaを作成する",
          "entity": "ideas",
          "changes": {
            "title": "入力値",
            "description": "入力値",
            "order": "末尾",
            "pinned": false
          }
        },
        {
          "name": "Ideaを編集する",
          "entity": "ideas",
          "changes": {
            "title": "入力値",
            "description": "入力値"
          }
        },
        {
          "name": "Ideaのピン留め状態を切り替える",
          "entity": "ideas",
          "changes": {
            "pinned": [
              true,
              false
            ]
          }
        },
        {
          "name": "Ideaを並べ替える",
          "entity": "ideas",
          "changes": {
            "order": "新しい表示順"
          }
        },
        {
          "name": "Ideaを削除する",
          "entity": "ideas",
          "when": "確認後に一覧から除外"
