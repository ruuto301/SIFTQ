{
  "domains": {
    "string": {
      "kind": "primitive"
    },
    "boolean": {
      "kind": "primitive"
    },
    "number": {
      "kind": "primitive"
    },
    "datetime": {
      "kind": "primitive"
    },
    "status": {
      "kind": "state",
      "logical": "string",
      "values": [
        "do",
        "done",
        "skip"
      ]
    },
    "idea_color": {
      "kind": "state",
      "logical": "string",
      "values": [
        "default",
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple"
      ]
    }
  },
  "entities": {
    "tasks": {
      "description": "タスク。実行対象・完了・見送りを status で表す。",
      "attributes": {
        "id": {
          "domain": "string",
          "pk": true
        },
        "owner_id": {
          "domain": "string"
        },
        "title": {
          "domain": "string",
          "note": "Unicodeコードポイント数で1以上256以下",
          "rules": [
            "INV-TM-005"
          ]
        },
        "description": {
          "domain": "string",
          "note": "Unicodeコードポイント数で0以上16,384以下",
          "rules": [
            "INV-TM-006"
          ]
        },
        "status": {
          "domain": "status",
          "rules": [
            "INV-TM-001"
          ]
        },
        "working": {
          "domain": "boolean",
          "rules": [
            "INV-TM-003"
          ]
        },
        "project": {
          "domain": "string",
          "note": "projects.id または未設定（NULL）",
          "rules": [
            "INV-TM-002"
          ]
        },
        "order": {
          "domain": "number",
          "note": "owner_id 内の表示順"
        },
        "version": {
          "domain": "number"
        },
        "created_at": {
          "domain": "datetime"
        },
        "updated_at": {
          "domain": "datetime"
        }
      },
      "rules": [
        "INV-TM-004"
      ]
    },
    "projects": {
      "description": "タスクの分類先。sort_order の昇順で表示する。",
      "attributes": {
        "id": {
          "domain": "string",
          "pk": true
        },
        "name": {
          "domain": "string"
        },
        "sort_order": {
          "domain": "number"
        }
      }
    },
    "ideas": {
      "description": "アイデアメモ。色・ピン・アーカイブ・ゴミ箱で整理し、画像とリンクプレビューを添える。",
      "attributes": {
        "id": {
          "domain": "string",
          "pk": true
        },
        "owner_id": {
          "domain": "string"
        },
        "title": {
          "domain": "string",
          "note": "Unicodeコードポイント数で1以上256以下"
        },
        "body": {
          "domain": "string",
          "note": "Unicodeコードポイント数で0以上16,384以下"
        },
        "color": {
          "domain": "idea_color"
        },
        "pinned": {
          "domain": "boolean"
        },
        "created_at": {
          "domain": "datetime"
        },
        "updated_at": {
          "domain": "datetime"
        },
        "archived_at": {
          "domain": "datetime",
          "note": "アーカイブ日時。NULL は未アーカイブ"
        },
        "deleted_at": {
          "domain": "datetime",
          "note": "ゴミ箱の日時。NULL は未削除"
        },
        "preview_title": {
          "domain": "string",
          "note": "リンクプレビューのタイトル。NULL 可"
        },
        "preview_description": {
          "domain": "string",
          "note": "リンクプレビューの説明。NULL 可"
        },
        "preview_image": {
          "domain": "string",
          "note": "リンクプレビューの画像 URL。NULL 可"
        },
        "preview_domain": {
          "domain": "string",
          "note": "リンクプレビューのドメイン。NULL 可"
        },
        "preview_fetched_at": {
          "domain": "datetime",
          "note": "リンクプレビューの取得日時。NULL 可"
        }
      }
    }
  },
  "screens": {
    "P00": {
      "name": "Login",
      "entities": [
        "tasks"
      ],
      "onLoad": "html_login_page",
      "actions": [
        "github-login"
      ]
    },
    "P02": {
      "name": "Task list",
      "entities": [
        "tasks",
        "projects"
      ],
      "onLoad": "html_tasks_page",
      "references": [
        "tasks_list"
      ],
      "actions": [
        "filter",
        "bulk",
        "project",
        "delete"
      ]
    },
    "P03": {
      "name": "Task detail",
      "entities": [
        "tasks",
        "projects"
      ],
      "onLoad": "html_task_page",
      "references": [
        "tasks_get"
      ],
      "actions": [
        "edit",
        "save",
        "select-project"
      ]
    },
    "P04": {
      "name": "New task",
      "entities": [
        "tasks",
        "projects"
      ],
      "onLoad": "html_new_task_page",
      "references": [
        "tasks_create"
      ],
      "actions": [
        "create",
        "select-project",
        "cancel"
      ]
    },
    "P05": {
      "name": "Status popover",
      "entities": [
        "tasks"
      ],
      "actions": [
        "select-status"
      ]
    },
    "P14": {
      "name": "Ideas",
      "entities": [
        "ideas"
      ],
      "onLoad": "html_ideas_page",
      "references": [
        "ideas_notes",
        "ideas_notes_bulk",
        "ideas_notes_id",
        "ideas_notes_id_delete",
        "ideas_notes_id_preview",
        "ideas_notes_id_images",
        "ideas_images_id_delete"
      ],
      "actions": [
        "create",
        "edit",
        "delete",
        "pin",
        "color",
        "archive",
        "trash",
        "restore",
        "purge",
        "image"
      ]
    }
  },
